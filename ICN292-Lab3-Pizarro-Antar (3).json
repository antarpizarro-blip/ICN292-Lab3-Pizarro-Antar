    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nconst grupos = $input.all();\n\nlet monto_total = 0;\nlet cantidad_total = 0;\nlet aprobadas = 0;\nlet desglose = \"\";\n\nfor (const grupo of grupos) {\n\n  const nombre_ruta = grupo.json.ruta || \"Sin Ruta\";\n  const cantidad = grupo.json.count_ruta || grupo.json.count || 0;\n  const monto_ruta = grupo.json.sum_monto_clp || grupo.json.monto || 0;\n  monto_total += monto_ruta;\n  cantidad_total += cantidad;\n\n  if (nombre_ruta.includes(\"APROBACION\")) {\n    aprobadas += cantidad;\n  }\n  desglose += `• ${nombre_ruta}: ${cantidad} solicitudes | Monto: $${monto_ruta.toLocaleString('es-CL')}\\n`;\n}\n\nconst tasa_aprobacion = cantidad_total > 0 \n  ? ((aprobadas / cantidad_total) * 100).toFixed(1) \n  : 0;\n\nconst mensaje_final = `REPORTE DIARIO DE DEVOLUCIONES\n\n DESGLOSE POR RUTA:\n${desglose}\n\nRESUMEN GENERAL:\n• Total Solicitudes Procesadas: ${cantidad_total}\n• Solicitudes Aprobadas: ${aprobadas}\n• Tasa de Aprobación: ${tasa_aprobacion}%\n• Monto Total Consolidado: $${monto_total.toLocaleString('es-CL')}`;\n\nreturn {\n  json: {\n    monto_total_global: monto_total,\n    total_solicitudes: cantidad_total,\n    solicitudes_aprobadas: aprobadas,\n    tasa_aprobacion: tasa_aprobacion,\n    desglose_texto: desglose,\n    mensaje_completo: mensaje_final\n  }\n}"
      },
